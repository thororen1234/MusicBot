# Discord Bot Configuration
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# SongLink API (converts Spotify/Apple Music/Deezer/Tidal links to YouTube)
SONGLINK_API_URL=
# Only needed if the API has API_KEYS set
SONGLINK_API_KEY=

# Tidal playback through a TidalSubsonic server (optional)
# Use the Subsonic user you created on that server
TIDAL_SUBSONIC_URL=
TIDAL_SUBSONIC_USER=
TIDAL_SUBSONIC_PASSWORD=
# Default /play and /search source: youtube, tidal or soundcloud (blank = youtube)
DEFAULT_SOURCE=

# Flowery TTS (use /play ftts://Your text). All settings are optional.
FLOWERY_TTS_API_URL=https://api.flowery.pw/v1/tts
FLOWERY_TTS_VOICE=Andrew
FLOWERY_TTS_TRANSLATE=false
FLOWERY_TTS_SILENCE=0
FLOWERY_TTS_SPEED=1
FLOWERY_TTS_AUDIO_FORMAT=mp3

# Google Translate TTS (use /play speak:Your text)
GOOGLE_TTS_LANGUAGE=en-US

# Maximum Discord attachment size accepted by /play (in MB)
MAX_UPLOAD_SIZE_MB=25

# Disable any providers, comma-separated (for example: tiktok,reddit,pornhub).
# Names: youtube, soundcloud, tidal, spotify, applemusic, deezer, yandex, vk,
# qobuz, jiosaavn, mixcloud, ocremix, clypit, reddit, getyarn, tiktok,
# soundgasm, pixeldrain, tumblr, pornhub, flowerytts, speechtts, streamdeck, upload, direct
DISABLED_PROVIDERS=

# Spotify API Configuration (optional - only used for Spotify playlist/artist links)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API Configuration
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# Bot Settings (Optional - defaults will be used if not set)
EMBED_COLOR="#FF6B6B"
SUPPORT_SERVER=https://discord.gg/ACJQzJuckW
WEBSITE=https://beatra.app
STATUS=🎵 Beatra | /play

# Sharding Settings (For bots with 1000+ servers)
# Leave as 'auto' for automatic configuration
TOTAL_SHARDS=auto
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=30000

# YouTube Cookie Settings (Fix for bot detection errors)
# Method 1: Use browser cookies (recommended - easier to keep up-to-date)
# Options: chrome, firefox, edge, safari
# Example: COOKIES_FROM_BROWSER=chrome
COOKIES_FROM_BROWSER=

# Method 2: Use cookies.txt file
# Export cookies from browser extension and save as cookies.txt
# Example: COOKIES_FILE=./cookies.txt
COOKIES_FILE=
